docs/**/*.svg
docs/**/*.png

# build output and test artifacts
dist/
build/
out/
release/
coverage/
*.tsbuildinfo
*.log

# local environment and secrets
.env
.env.*
*.local

# OS and editor noise
.DS_Store
Thumbs.db
.idea/
.vscode/
