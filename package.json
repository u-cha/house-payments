{
  "name": "house-payments",
  "private": true,
  "description": "house-payments: product monorepo — design artifacts and the desktop app",
  "scripts": {
    "dev": "pnpm --filter @house-payments/desktop dev",
    "dist:mac": "pnpm --filter @house-payments/desktop dist:mac",
    "test": "node --test tests/*.test.mjs && pnpm --filter @house-payments/desktop test",
    "test:e2e": "pnpm --filter @house-payments/desktop test:e2e",
    "arch": "pnpm --filter @house-payments/desktop arch",
    "lint": "pnpm --filter @house-payments/desktop lint",
    "typecheck": "pnpm --filter @house-payments/desktop typecheck",
    "validate": "node scripts/validate-docs.mjs",
    "check": "pnpm validate && pnpm arch && pnpm test && pnpm test:e2e",
    "sync:main": "node scripts/sync-main.mjs",
    "ci:status": "node scripts/ci-status.mjs",
    "diagrams": "bash scripts/render-diagrams.sh",
    "diagrams:examples": "bash scripts/render-diagrams.sh --with-examples",
    "bootstrap": "node scripts/bootstrap-skills.mjs"
  },
  "packageManager": "pnpm@12.15.0",
  "devDependencies": {
    "@dbml/cli": "^11.0.1",
    "@mermaid-js/mermaid-cli": "^11.17.1",
    "@softwaretechnik/dbml-renderer": "^1.0.31"
  }
}
